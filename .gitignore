# Dependencias y caché de npm
node_modules/
.npm/

# Compilaciones de Vite y cachés de TypeScript/ESLint
/dist/
/dist-ssr/
.vite/
.cache/
.eslintcache
*.tsbuildinfo

# Logs (se conservan scripts, resultados JSON y documentación de pruebas)
*.log
logs/

# Temporales y copias automáticas de editores
/tmp/
/temp/
.tmp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
*.swp
*.swo

# Entornos privados; la plantilla sin secretos sí se versiona
.env
.env.*
!.env.example
*.local

# Editores y metadatos del sistema
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.Identifier
*:Zone.Identifier

# Recuperaciones generadas; conservar instrucciones y hashes útiles
/docs/recovery/*
!/docs/recovery/*.md
!/docs/recovery/SHA256SUMS
!/docs/recovery/SHA256SUMS.txt
# Copias locales de recuperación
/docs/recovery/
