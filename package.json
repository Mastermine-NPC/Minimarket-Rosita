{
  "name": "minimarket-rosita",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm run lint && npm run check:contrast && npm run build",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:operations": "node scripts/verify-operations.mjs --offline && node scripts/verify-operations-edges.mjs --offline",
    "test:routing:live": "node scripts/verify-operations.mjs && node scripts/verify-operations-edges.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "test:catalog": "node scripts/verify-model-catalog.mjs && node scripts/verify-normal-catalog.mjs && node scripts/verify-halloween.mjs",
    "test": "npm run test:operations && npm run test:catalog && npm run test:order-flow && npm run test:international-phone",
    "test:order-flow": "node scripts/verify-order-flow.mjs",
    "test:international-phone": "node scripts/verify-international-phone.mjs",
    "test:halloween": "node scripts/verify-halloween.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gsap": "3.15.0",
    "leaflet": "1.9.4",
    "lenis": "1.3.27",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "^1.64.0",
    "maplibre-gl": "6.16.0",
    "motion": "^14.7.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "three": "0.187.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "shadcn": "4.23.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=11 <12"
  },
  "overrides": {
    "@mapbox/jsonlint-lines-primitives": "2.0.2"
  }
}
