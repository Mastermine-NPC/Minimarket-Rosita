{
  "version": 8,
  "name": "Rosita · Dark Night",
  "metadata": {
    "rosita:theme": "dark-night",
    "rosita:description": "Custom vector basemap. No raster filters."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org/\" target=\"_blank\" rel=\"noopener\">OpenFreeMap</a> · <a href=\"https://openmaptiles.org/\" target=\"_blank\" rel=\"noopener\">OpenMapTiles</a> · © <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap</a>"
    }
  },
  "layers": [
    {
      "id": "night-background",
      "type": "background",
      "paint": {
        "background-color": "#0b1422"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "wood",
            "grass",
            "wetland"
          ],
          "#172b2a",
          "#101c29"
        ],
        "fill-opacity": 0.75
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "park",
            "forest",
            "cemetery",
            "grass"
          ],
          "#172b2a",
          [
            "industrial",
            "commercial"
          ],
          "#152233",
          "#111e2d"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#1a302d",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#091f31"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#18394b",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.5,
          16,
          2
        ],
        "line-opacity": 0.8
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#1b293a",
        "fill-outline-color": "#28384b",
        "fill-opacity": 0.75
      },
      "minzoom": 14
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#4b596d",
        "line-width": 1,
        "line-dasharray": [
          3,
          4
        ],
        "line-opacity": 0.32
      }
    },
    {
      "id": "railways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#3d4c60",
        "line-width": 1,
        "line-dasharray": [
          2,
          3
        ],
        "line-opacity": 0.5
      },
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ]
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#0a1523",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          1.3,
          12,
          3,
          16,
          9,
          20,
          24
        ]
      },
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "secondary-streets",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "service",
            "track",
            "path"
          ],
          "#213145",
          "#2c3e53"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.4,
          14,
          1.2,
          17,
          4,
          20,
          11
        ],
        "line-opacity": [
          "case",
          [
            "==",
            [
              "get",
              "brunnel"
            ],
            "tunnel"
          ],
          0.45,
          0.95
        ]
      },
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "minor",
          "service",
          "track",
          "path",
          "residential",
          "unclassified"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "main-streets",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk"
          ],
          "#5b7088",
          "primary",
          "#52667d",
          "#40556d"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          0.8,
          12,
          1.8,
          16,
          6,
          20,
          20
        ],
        "line-opacity": [
          "case",
          [
            "==",
            [
              "get",
              "brunnel"
            ],
            "tunnel"
          ],
          0.45,
          1
        ]
      },
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "paint": {
        "text-color": "#c2cdda",
        "text-halo-color": "#0b1422",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.5
      },
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 300,
        "text-field": [
          "coalesce",
          [
            "get",
            "name:es"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          11,
          18,
          13
        ],
        "text-max-angle": 35,
        "text-padding": 8
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "paint": {
        "text-color": "#839aaf",
        "text-halo-color": "#091f31",
        "text-halo-width": 1.2
      },
      "minzoom": 8,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:es"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 12,
        "text-max-width": 8
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "paint": {
        "text-color": "#c2cdda",
        "text-halo-color": "#0b1422",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.5
      },
      "minzoom": 4,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "city",
          "town",
          "village",
          "suburb",
          "neighbourhood",
          "hamlet"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:es"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          11,
          10,
          13,
          16,
          15
        ],
        "text-max-width": 10,
        "text-padding": 16
      }
    }
  ]
}
